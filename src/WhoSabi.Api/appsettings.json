{
  "PublicApiUrl": "https://api.whosabi.ng",
  "Cors": { "AllowedOrigins": ["https://whosabi.ng", "https://www.whosabi.ng"] },
  "Monnify": { "BaseUrl": "https://sandbox.monnify.com", "AllowLivePayments": false },
  "Wallet": { "TransfersEnabled": false, "MaxTransferKobo": 1000000, "DailyTransferLimitKobo": 5000000, "MaxDepositKobo": 10000000 },
  "Jwt": {
    "Issuer": "WhoSabi.Api",
    "Audience": "WhoSabi.Client",
    "AccessTokenMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
